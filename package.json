{
  "name": "nzombokwe-family-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "build:css": "tailwindcss -i ./src/public/styles/input.css -o ./src/public/styles/app.css --minify",
    "watch:css": "tailwindcss -i ./src/public/styles/input.css -o ./src/public/styles/app.css --watch",
    "test": "node --test",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:make:migration": "node scripts/make-db-file.js migration",
    "db:make:seeder": "node scripts/make-db-file.js seeder",
    "db:migrate:status": "sequelize-cli db:migrate:status"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^3.4.17"
  }
}
